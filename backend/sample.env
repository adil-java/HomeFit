PORT=
DATABASE_URL=
JWT_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=
NODE_ENV=development   
# Firebase *web* API key (same public key as frontend/firebaseConfig.ts) — used to check admin passwords
FIREBASE_WEB_API_KEY=
# Public https URL of this API in production (Stripe onboarding return pages)
API_PUBLIC_URL=
# Stripe Connect seller country and webhook signing secret
STRIPE_CONNECT_COUNTRY=US
STRIPE_WEBHOOK_SECRET=
# Server logs: silent | error | warn (default) | debug
LOG_LEVEL=warn
